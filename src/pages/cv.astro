---
import Base from '../layouts/Base.astro';
import { site } from '../lib/site';
import { inline } from '../lib/inline';
import { cv } from '../data/cv';

/*
 * This page renders whatever `src/data/cv.ts` contains, in order. To change the
 * CV, edit that file — there is nothing to edit here.
 *
 * The web CV is allowed to run to several screens. The one-page constraint
 * belongs to the resume PDF, which is a separate document.
 */
---

<Base
  title="CV"
  description="Curriculum vitae — Felipe Caicedo. MIT mathematics with computer science, IMO bronze medallist, AI engineering intern at Alpha School."
>
  <header class="cv-head">
    <p class="u-eyebrow">Curriculum vitae</p>
    <h1 class="cv-head__title">Felipe Caicedo</h1>
    <ul class="cv-head__contact u-mono">
      {
        site.links.map((l) => (
          <li>
            <a href={l.href}>{l.href.replace(/^mailto:|^https?:\/\//, '')}</a>
          </li>
        ))
      }
    </ul>
    {
      site.cvPdf && (
        <p class="cv-head__pdf u-mono no-print">
          <a href={site.cvPdf}>Download the one-page resume (PDF)</a>
        </p>
      )
    }
  </header>

  <div class="cv-gap"></div>

  {
    cv.map((section) => {
      const id = `cv-${section.label.toLowerCase().replace(/[^a-z]+/g, '-')}`;
      return (
        <section class="cv-sec" aria-labelledby={id}>
          <h2 id={id} class="cv-sec__label u-mono">
            {section.label}
          </h2>

          <div class="cv-sec__body">
            {section.kind === 'entries' &&
              section.entries.map((e) => (
                <article class="entry">
                  <h3 class="entry__role">{e.role}</h3>
                  <p class="entry__org">{e.org}</p>
                  <p class="entry__when u-mono">
                    {e.where ? `${e.when} · ${e.where}` : e.when}
                  </p>
                  <ul class="entry__points">
                    {e.points.map((p) => (
                      <li set:html={inline(p)} />
                    ))}
                  </ul>
                </article>
              ))}

            {section.kind === 'list' && (
              <ul class="plain">
                {section.items.map((item) => (
                  <li set:html={inline(item)} />
                ))}
              </ul>
            )}

            {section.kind === 'pairs' && (
              <dl class="pairs">
                {section.pairs.map((p) => (
                  <div class="pairs__row">
                    <dt>{p.label}</dt>
                    <dd set:html={inline(p.value)} />
                  </div>
                ))}
              </dl>
            )}
          </div>
        </section>
      );
    })
  }

  <p class="cv-see no-print">
    Longer write-ups of the projects live under <a href="/work">work</a>.
  </p>
</Base>

<style>
  .cv-head__title {
    font-size: var(--t-2xl);
    margin: 0 0 0.8rem;
  }

  .cv-head__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    list-style: none;
    margin: 0;
    padding: 0;
    text-transform: none;
    letter-spacing: 0.04em;
  }

  .cv-head__contact a {
    text-decoration: none;
    border-bottom: 1px solid var(--rule-strong);
  }

  .cv-head__contact a:hover {
    border-bottom-color: var(--vermilion);
  }

  .cv-head__pdf {
    margin: 0.9rem 0 0;
    text-transform: none;
    letter-spacing: 0.04em;
  }

  .cv-gap {
    height: clamp(1.5rem, 4vw, 2.25rem);
  }

  /* Section labels hang in the margin, like running heads. */
  .cv-sec {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 0 2rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--rule);
  }

  .cv-sec:last-of-type {
    border-bottom: 1px solid var(--rule);
  }

  .cv-sec__label {
    margin: 0;
    padding-top: 0.3rem;
    color: var(--ink-faint);
  }

  .cv-sec__body {
    min-width: 0;
  }

  .entry + .entry {
    margin-top: 1.5rem;
  }

  .entry__role {
    font-size: var(--t-md);
    margin: 0 0 0.15rem;
  }

  .entry__org {
    margin: 0 0 0.15rem;
    color: var(--ink-soft);
  }

  .entry__when {
    margin: 0 0 0.55rem;
    text-transform: none;
    letter-spacing: 0.04em;
  }

  .entry__points {
    margin: 0;
    padding-left: 1.1rem;
  }

  .entry__points > li {
    margin-bottom: 0.4rem;
  }

  .plain {
    list-style: none;
    margin: 0;
    padding-left: 0;
  }

  .plain > li {
    margin-bottom: 0.4rem;
  }

  .pairs {
    margin: 0;
  }

  .pairs__row {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 0 1rem;
    margin-bottom: 0.4rem;
  }

  .pairs dt {
    font-family: var(--mono);
    font-size: var(--t-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
    padding-top: 0.28em;
  }

  .pairs dd {
    margin: 0;
  }

  .cv-see {
    margin: 1.5rem 0 0;
    color: var(--ink-soft);
  }

  @media (max-width: 40rem) {
    .cv-sec,
    .pairs__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.4rem;
    }

    .cv-sec__label {
      padding-top: 0;
    }
  }
</style>
